<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Towergeneration</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <NoWarn>1591;8618</NoWarn>
    <!-- Copy all NuGet dependency DLLs (e.g. PdfSharp) to the output directory -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- AutoCAD .NET NuGet -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfSharp" Version="6.2.0" />
  </ItemGroup>

  <!-- AcWindows – provides PaletteSet (already loaded by AutoCAD at runtime) -->
  <ItemGroup>
    <Reference Include="AcWindows">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2026\AcWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Advance Steel managed API – not copied to output (AS loads them at runtime) -->
  <ItemGroup>
    <Reference Include="ASMgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2026\ADVS\ASMgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ASObjectsMgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2026\ADVS\ASObjectsMgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ASGeometryMgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2026\ADVS\ASGeometryMgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ASCADLinkMgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2026\ADVS\ASCADLinkMgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="ASProfilesMgd">
      <HintPath>C:\Program Files\Autodesk\AutoCAD 2026\ADVS\ASProfilesMgd.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="myCommands.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>myCommands.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="myCommands.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>myCommands.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\tower logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>tower logo.png</Link>
    </Content>
    <Content Include="..\cctech logo image.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>cctech logo image.png</Link>
    </Content>
  </ItemGroup>
</Project>
